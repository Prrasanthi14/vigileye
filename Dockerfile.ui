# VigilEye pilot dashboard (Streamlit client of the readiness API)
FROM python:3.12-slim
WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[ui]"

COPY ui/ ./ui/
ENV PYTHONUNBUFFERED=1
CMD ["sh", "-c", "streamlit run ui/dashboard.py --server.port=${PORT:-8080} --server.address=0.0.0.0"]
