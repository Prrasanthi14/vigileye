# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=vigileye_fleet
DATA_SOURCE=bigquery          # bigquery | sqlite

# Gemini agent — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro-latest
GEMINI_RPM=20                 # stay under the per-model requests/minute quota

# Dashboard -> API
API_BASE_URL=http://localhost:8000

# Oura ingestion (optional)
OURA_ACCESS_TOKEN=
